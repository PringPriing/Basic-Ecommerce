<nav>
    <div class="pagination">
        <button @onclick="() => OnPageChanged.InvokeAsync(CurrentPage - 1)" disabled="@(!HasPrevious)">‹</button>
        @for (int i = 1; i <= TotalPages; i++)
        {
            var pageNum = i;
            <button class="@(pageNum == CurrentPage ? "is-active" : "")"
                    @onclick="() => OnPageChanged.InvokeAsync(pageNum)">@pageNum</button>
        }
        <button @onclick="() => OnPageChanged.InvokeAsync(CurrentPage + 1)" disabled="@(!HasNext)">›</button>
    </div>
</nav>

@code {
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }

    private bool HasPrevious => CurrentPage > 1;
    private bool HasNext => CurrentPage < TotalPages;
}
