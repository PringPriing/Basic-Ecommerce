<nav aria-label="Page navigation">
    <ul class="pagination justify-content-center">
        <li class="page-item @(!HasPrevious ? "disabled" : "")">
            <button class="page-link" @onclick="() => OnPageChanged.InvokeAsync(CurrentPage - 1)"
                    disabled="@(!HasPrevious)">Previous</button>
        </li>
        @for (int i = 1; i <= TotalPages; i++)
        {
            var pageNum = i;
            <li class="page-item @(pageNum == CurrentPage ? "active" : "")">
                <button class="page-link" @onclick="() => OnPageChanged.InvokeAsync(pageNum)">@pageNum</button>
            </li>
        }
        <li class="page-item @(!HasNext ? "disabled" : "")">
            <button class="page-link" @onclick="() => OnPageChanged.InvokeAsync(CurrentPage + 1)"
                    disabled="@(!HasNext)">Next</button>
        </li>
    </ul>
</nav>

@code {
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }

    private bool HasPrevious => CurrentPage > 1;
    private bool HasNext => CurrentPage < TotalPages;
}
