@inject CartApiService CartApi
@inject NavigationManager Nav

<div class="card h-100 shadow-sm">
    <img src="@(Product.ImageUrl ?? "https://placehold.co/300x200?text=No+Image")"
         class="card-img-top" alt="@Product.Name" style="height:200px;object-fit:cover;" />
    <div class="card-body d-flex flex-column">
        <h6 class="card-title">@Product.Name</h6>
        <p class="card-text text-muted small flex-grow-1">@Product.ShortDescription</p>
        <div class="d-flex flex-wrap gap-1 mb-2">
            @foreach (var cat in Product.CategoryNames)
            {
                <span class="badge bg-secondary">@cat</span>
            }
        </div>
        <div class="d-flex justify-content-between align-items-center mt-auto">
            <strong class="text-success">$@Product.Price.ToString("F2")</strong>
            <div class="btn-group btn-group-sm">
                <button class="btn btn-outline-primary" @onclick="ViewDetail">Details</button>
                <AuthorizeView>
                    <Authorized>
                        <button class="btn btn-primary" @onclick="AddToCart" disabled="@adding">
                            @(adding ? "Adding..." : "Add to Cart")
                        </button>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ProductSummaryDto Product { get; set; } = null!;

    private bool adding;

    private void ViewDetail() => Nav.NavigateTo($"/products/{Product.Id}");

    private async Task AddToCart()
    {
        adding = true;
        await CartApi.AddItemAsync(new AddToCartRequest { ProductId = Product.Id, Quantity = 1 });
        adding = false;
    }
}
