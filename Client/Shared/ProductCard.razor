@inject CartApiService CartApi
@inject NavigationManager Nav

<div class="product-card" @onclick="ViewDetail">
    <div class="product-card__media">
        @if (!string.IsNullOrEmpty(Product.ImageUrl))
        {
            <img src="@Product.ImageUrl" alt="@Product.Name" />
        }
        else
        {
            <div class="product-card__no-img">No image</div>
        }
        <AuthorizeView>
            <Authorized>
                <button class="product-card__quick"
                        @onclick:stopPropagation="true"
                        @onclick="AddToCart"
                        disabled="@adding">
                    @(adding ? "Adding…" : "Add to cart")
                </button>
            </Authorized>
            <NotAuthorized>
                <button class="product-card__quick" @onclick:stopPropagation="true" @onclick="ViewDetail">
                    View details
                </button>
            </NotAuthorized>
        </AuthorizeView>
    </div>
    <div>
        <div class="product-card__info">
            <div>
                <div class="product-card__name">@Product.Name</div>
                @if (Product.CategoryNames.Any())
                {
                    <div class="product-card__cat">@string.Join(", ", Product.CategoryNames)</div>
                }
            </div>
            <div class="product-card__price">$@Product.Price.ToString("F0")</div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ProductSummaryDto Product { get; set; } = null!;

    private bool adding;

    private void ViewDetail() => Nav.NavigateTo($"/products/{Product.Id}");

    private async Task AddToCart()
    {
        adding = true;
        await CartApi.AddItemAsync(new AddToCartRequest { ProductId = Product.Id, Quantity = 1 });
        adding = false;
    }
}
