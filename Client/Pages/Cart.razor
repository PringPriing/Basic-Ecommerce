@page "/cart"
@attribute [Authorize]
@inject CartApiService CartApi
@inject CheckoutApiService CheckoutApi
@inject NavigationManager Nav

<PageTitle>Shopping Cart — E-Shop</PageTitle>

<h2>Shopping Cart</h2>

@if (cart == null)
{
    <p><em>Loading...</em></p>
}
else if (!cart.Items.Any())
{
    <div class="text-center py-5">
        <p class="text-muted">Your cart is empty.</p>
        <a href="/products" class="btn btn-primary">Continue Shopping</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Unit Price</th>
                    <th>Quantity</th>
                    <th>Subtotal</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in cart.Items)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <img src="@(item.ProductImageUrl ?? "https://placehold.co/60x60?text=?")"
                                     width="60" height="60" class="rounded" style="object-fit:cover;" />
                                @item.ProductName
                            </div>
                        </td>
                        <td>$@item.UnitPrice.ToString("F2")</td>
                        <td>
                            <div class="input-group input-group-sm" style="width:110px;">
                                <button class="btn btn-outline-secondary" @onclick="() => Decrement(item)">-</button>
                                <input type="number" class="form-control text-center" value="@item.Quantity"
                                       @onchange="e => UpdateQty(item, int.Parse(e.Value!.ToString()!))" min="1" max="100" />
                                <button class="btn btn-outline-secondary" @onclick="() => Increment(item)">+</button>
                            </div>
                        </td>
                        <td>$@item.Subtotal.ToString("F2")</td>
                        <td>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Remove(item.Id)">Remove</button>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3" class="text-end fw-bold">Total</td>
                    <td colspan="2" class="fw-bold text-success">$@cart.Total.ToString("F2")</td>
                </tr>
            </tfoot>
        </table>
    </div>

    @if (checkoutError is not null)
    {
        <div class="alert alert-danger">@checkoutError</div>
    }

    <div class="d-flex justify-content-between">
        <button class="btn btn-outline-danger" @onclick="ClearCart">Clear Cart</button>
        <button class="btn btn-success" @onclick="StartCheckout" disabled="@checkingOut">
            @(checkingOut ? "Redirecting..." : "Checkout")
        </button>
    </div>
}

@code {
    private CartDto? cart;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => cart = await CartApi.GetCartAsync();

    private async Task Remove(int itemId)
    {
        await CartApi.RemoveItemAsync(itemId);
        await LoadAsync();
    }

    private async Task UpdateQty(CartItemDto item, int qty)
    {
        if (qty < 1) return;
        await CartApi.UpdateItemAsync(item.Id, new UpdateCartItemRequest { Quantity = qty });
        await LoadAsync();
    }

    private Task Increment(CartItemDto item) => UpdateQty(item, item.Quantity + 1);
    private Task Decrement(CartItemDto item) => item.Quantity > 1
        ? UpdateQty(item, item.Quantity - 1)
        : Remove(item.Id);

    private async Task ClearCart()
    {
        await CartApi.ClearCartAsync();
        await LoadAsync();
    }

    private bool checkingOut;
    private string? checkoutError;

    private async Task StartCheckout()
    {
        checkingOut = true;
        checkoutError = null;
        try
        {
            var result = await CheckoutApi.CreateSessionAsync();
            if (result?.SessionUrl is not null)
                Nav.NavigateTo(result.SessionUrl, forceLoad: true);
            else
                checkoutError = "Could not start checkout. Please try again.";
        }
        catch (Exception ex)
        {
            checkoutError = $"Error: {ex.Message}";
        }
        finally
        {
            checkingOut = false;
        }
    }
}
