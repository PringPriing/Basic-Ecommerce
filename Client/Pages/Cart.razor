@page "/cart"
@attribute [Authorize]
@inject CartApiService CartApi
@inject CheckoutApiService CheckoutApi
@inject NavigationManager Nav

<PageTitle>Cart — E-Shop.</PageTitle>

@if (cart == null)
{
    <div class="container" style="padding:80px 32px;text-align:center">
        <div class="skeleton" style="height:56px;width:200px;margin:0 auto;border-radius:4px"></div>
    </div>
}
else if (!cart.Items.Any())
{
    <div class="container" style="padding:120px 32px;text-align:center">
        <svg viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="1" width="64" height="64">
            <path d="M4 5h2.5l2 12h10l2-8H7"/><circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/>
        </svg>
        <h2 style="font-size:36px;margin-top:24px">Your cart is empty</h2>
        <p style="color:var(--muted);margin-top:12px">Add something beautiful to get started.</p>
        <a href="/products" class="btn btn--primary btn--lg" style="margin-top:28px">Continue shopping</a>
    </div>
}
else
{
    <div class="container" style="padding:40px 32px 0">
        <h1 style="font-size:clamp(36px,4vw,56px)">Your cart</h1>
        <p style="color:var(--muted);margin-top:8px">@cart.Items.Count @(cart.Items.Count == 1 ? "item" : "items") · review and check out</p>
    </div>

    <div class="container" style="padding:32px;display:grid;grid-template-columns:1.6fr 1fr;gap:56px;padding-bottom:80px">
        <!-- Items list -->
        <div>
            <div style="display:flex;flex-direction:column;gap:16px">
                @foreach (var item in cart.Items)
                {
                    <div class="surface" style="padding:20px;display:grid;grid-template-columns:100px 1fr;gap:20px;align-items:start">
                        <div style="aspect-ratio:1;border-radius:var(--radius);overflow:hidden;background:var(--surface-2)">
                            @if (!string.IsNullOrEmpty(item.ProductImageUrl))
                            {
                                <img src="@item.ProductImageUrl" style="width:100%;height:100%;object-fit:cover" alt="@item.ProductName" />
                            }
                        </div>
                        <div>
                            <div style="display:flex;justify-content:space-between;gap:12px">
                                <div>
                                    <div style="font-family:var(--font-display);font-size:20px">@item.ProductName</div>
                                </div>
                                <div class="price" style="font-size:18px;white-space:nowrap">$@item.Subtotal.ToString("F2")</div>
                            </div>
                            <div style="display:flex;align-items:center;justify-content:space-between;margin-top:16px">
                                <div class="qty-stepper">
                                    <button class="qty-stepper__btn" @onclick="() => Decrement(item)">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16"><path d="M5 12h14"/></svg>
                                    </button>
                                    <span class="qty-stepper__val">@item.Quantity</span>
                                    <button class="qty-stepper__btn" @onclick="() => Increment(item)">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16"><path d="M12 5v14M5 12h14"/></svg>
                                    </button>
                                </div>
                                <button class="btn btn--link" style="font-size:13px;color:var(--muted);border-bottom-color:var(--muted)"
                                        @onclick="() => Remove(item.Id)">
                                    Remove
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Trust strip -->
            <div class="surface--flat" style="margin-top:32px;padding:20px 24px;display:flex;gap:32px;border-radius:var(--radius-lg)">
                <div style="display:flex;align-items:center;gap:10px;font-size:13px;color:var(--ink-2)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" width="20" height="20">
                        <path d="M3 7h11v10H3zM14 10h4l3 3v4h-7"/><circle cx="7" cy="18" r="1.7"/><circle cx="17" cy="18" r="1.7"/>
                    </svg>
                    Free shipping above $80
                </div>
                <div style="display:flex;align-items:center;gap:10px;font-size:13px;color:var(--ink-2)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" width="20" height="20">
                        <path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/>
                    </svg>
                    30-day returns
                </div>
                <div style="display:flex;align-items:center;gap:10px;font-size:13px;color:var(--ink-2)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" width="20" height="20">
                        <path d="M12 3 4 6v6c0 5 3.5 8.5 8 9 4.5-.5 8-4 8-9V6z"/><path d="m9 12 2 2 4-4"/>
                    </svg>
                    Encrypted checkout
                </div>
            </div>
        </div>

        <!-- Summary panel -->
        <aside>
            <div style="position:sticky;top:96px">
                <div class="surface" style="padding:28px">
                    <h3 style="font-size:24px;margin-bottom:20px">Summary</h3>

                    <div style="display:flex;justify-content:space-between;padding:8px 0;font-size:14px">
                        <span>Subtotal</span>
                        <span>$@cart.Total.ToString("F2")</span>
                    </div>
                    <div style="display:flex;justify-content:space-between;padding:8px 0;font-size:14px">
                        <span>Shipping</span>
                        <span style="color:@(cart.Total > 80 ? "var(--success)" : "var(--ink)")">
                            @(cart.Total > 80 ? "Free" : "$8.00")
                        </span>
                    </div>
                    <div style="height:1px;background:var(--line);margin:16px 0"></div>
                    <div style="display:flex;justify-content:space-between;padding:8px 0;font-size:17px;font-weight:500">
                        <span>Total</span>
                        <span style="font-family:var(--font-display);font-size:24px">
                            $@((cart.Total + (cart.Total > 80 ? 0 : 8)).ToString("F2"))
                        </span>
                    </div>

                    @if (checkoutError is not null)
                    {
                        <div class="alert alert-danger" style="margin-top:16px">@checkoutError</div>
                    }

                    <button class="btn btn--primary btn--lg btn--block" style="margin-top:20px"
                            @onclick="StartCheckout" disabled="@checkingOut">
                        @(checkingOut ? "Redirecting…" : "Checkout securely")
                        @if (!checkingOut)
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18">
                                <path d="M5 12h14m-5-6 6 6-6 6"/>
                            </svg>
                        }
                    </button>
                    <div style="text-align:center;margin-top:12px;font-size:12px;color:var(--muted)">
                        Visa · Mastercard · Apple Pay · Google Pay
                    </div>
                </div>

                <div style="margin-top:16px">
                    <button class="btn btn--ghost btn--sm" @onclick="ClearCart"
                            style="width:100%;color:var(--muted);border-color:var(--line)">
                        Clear cart
                    </button>
                </div>
            </div>
        </aside>
    </div>
}

@code {
    private CartDto? cart;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => cart = await CartApi.GetCartAsync();

    private async Task Remove(int itemId)
    {
        await CartApi.RemoveItemAsync(itemId);
        await LoadAsync();
    }

    private async Task UpdateQty(CartItemDto item, int qty)
    {
        if (qty < 1) return;
        await CartApi.UpdateItemAsync(item.Id, new UpdateCartItemRequest { Quantity = qty });
        await LoadAsync();
    }

    private Task Increment(CartItemDto item) => UpdateQty(item, item.Quantity + 1);
    private Task Decrement(CartItemDto item) => item.Quantity > 1
        ? UpdateQty(item, item.Quantity - 1)
        : Remove(item.Id);

    private async Task ClearCart()
    {
        await CartApi.ClearCartAsync();
        await LoadAsync();
    }

    private bool checkingOut;
    private string? checkoutError;

    private async Task StartCheckout()
    {
        checkingOut = true;
        checkoutError = null;
        try
        {
            var result = await CheckoutApi.CreateSessionAsync();
            if (result?.SessionUrl is not null)
                Nav.NavigateTo(result.SessionUrl, forceLoad: true);
            else
                checkoutError = "Could not start checkout. Please try again.";
        }
        catch (Exception ex)
        {
            checkoutError = $"Error: {ex.Message}";
        }
        finally
        {
            checkingOut = false;
        }
    }
}
