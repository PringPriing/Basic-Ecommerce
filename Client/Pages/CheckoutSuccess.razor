@page "/checkout/success"
@attribute [Authorize]

<PageTitle>Payment Successful — E-Shop</PageTitle>

<div class="container py-5 text-center">
    <div class="mb-3" style="font-size:4rem; color:var(--bs-success);">&#10003;</div>
    <h2 class="text-success">Payment Successful!</h2>
    <p class="text-muted">Thank you for your order. You will receive a confirmation email shortly.</p>

    @if (!string.IsNullOrEmpty(sessionId))
    {
        <p class="small text-muted">Order reference: <code>@sessionId</code></p>
    }

    <div class="mt-4 d-flex justify-content-center gap-3">
        <a href="/products" class="btn btn-primary">Continue Shopping</a>
        <a href="/" class="btn btn-outline-secondary">Go to Home</a>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "session_id")]
    public string? SessionId { get; set; }

    private string? sessionId;

    protected override void OnInitialized() => sessionId = SessionId;
}
