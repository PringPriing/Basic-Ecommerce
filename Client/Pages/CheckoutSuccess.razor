@page "/checkout/success"
@attribute [Authorize]

<PageTitle>Order Confirmed — E-Shop.</PageTitle>

<div style="min-height:60vh;display:flex;align-items:center;justify-content:center;padding:80px 32px;text-align:center">
    <div style="max-width:480px">
        <div style="width:72px;height:72px;border-radius:99px;background:var(--success-bg);display:flex;align-items:center;justify-content:center;margin:0 auto 32px">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2" width="32" height="32">
                <path d="m5 12 5 5 9-11"/>
            </svg>
        </div>

        <div class="eyebrow" style="margin-bottom:12px;color:var(--success)">Order confirmed</div>
        <h1 style="font-size:48px;margin-bottom:16px">Thank you!</h1>
        <p style="color:var(--ink-2);font-size:16px;line-height:1.7;margin-bottom:12px">
            Your payment was successful. You'll receive a confirmation email with your order details shortly.
        </p>

        @if (!string.IsNullOrEmpty(sessionId))
        {
            <p style="font-size:12px;color:var(--muted);font-family:var(--font-mono);margin-bottom:32px">
                Order ref: @sessionId
            </p>
        }

        <div style="display:flex;gap:12px;justify-content:center;margin-top:32px">
            <a href="/products" class="btn btn--primary btn--lg">Continue shopping</a>
            <a href="/" class="btn btn--ghost btn--lg">Go home</a>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "session_id")]
    public string? SessionId { get; set; }

    private string? sessionId;

    protected override void OnInitialized() => sessionId = SessionId;
}
