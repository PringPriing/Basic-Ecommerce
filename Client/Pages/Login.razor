@page "/login"
@inject AuthService AuthSvc
@inject CustomAuthStateProvider AuthProvider
@inject NavigationManager Nav

<PageTitle>Login — E-Shop.</PageTitle>

<div style="min-height:60vh;display:flex;align-items:center;justify-content:center;padding:64px 32px">
    <div style="width:100%;max-width:420px">
        <div style="text-align:center;margin-bottom:40px">
            <div class="eyebrow" style="margin-bottom:12px">Welcome back</div>
            <h1 style="font-size:40px">Sign in</h1>
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger" style="margin-bottom:20px">@error</div>
        }

        <EditForm Model="model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" style="margin-bottom:16px;font-size:13px" />

            <div style="margin-bottom:16px">
                <label class="label">Email</label>
                <InputText class="field" @bind-Value="model.Email" placeholder="you@example.com" />
            </div>
            <div style="margin-bottom:24px">
                <label class="label">Password</label>
                <InputText type="password" class="field" @bind-Value="model.Password" placeholder="••••••••" />
            </div>

            <button type="submit" class="btn btn--primary btn--lg btn--block" disabled="@submitting">
                @(submitting ? "Signing in…" : "Sign in")
            </button>
        </EditForm>

        <p style="margin-top:24px;text-align:center;font-size:14px;color:var(--muted)">
            Don't have an account?
            <a href="/register" style="color:var(--ink);font-weight:500;text-decoration:underline">Register</a>
        </p>
    </div>
</div>

@code {
    private LoginRequest model = new();
    private string? error;
    private bool submitting;

    private async Task Submit()
    {
        submitting = true;
        error = null;
        var response = await AuthSvc.LoginAsync(model);
        if (response != null)
        {
            await AuthProvider.MarkAsAuthenticatedAsync(response.Token);
            Nav.NavigateTo("/");
        }
        else
        {
            error = "Invalid email or password.";
        }
        submitting = false;
    }
}
