@page "/categories"
@inject CategoryApiService CategoryApi

<PageTitle>Categories — E-Shop.</PageTitle>

<div class="container" style="padding-top:32px;padding-bottom:80px">
    <!-- Header row -->
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:40px">
        <div>
            <div class="eyebrow" style="margin-bottom:8px">Browse by</div>
            <h1 style="font-size:clamp(36px,4vw,56px)">Categories</h1>
        </div>
        <AuthorizeView Roles="Admin">
            <button class="btn btn--primary btn--sm" @onclick="ShowCreate">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16">
                    <path d="M12 5v14M5 12h14"/>
                </svg>
                Add category
            </button>
        </AuthorizeView>
    </div>

    @if (showForm)
    {
        <div class="surface" style="padding:28px;margin-bottom:32px;max-width:480px">
            <h3 style="font-size:22px;margin-bottom:20px">@(editing == null ? "New Category" : "Edit Category")</h3>
            <div style="margin-bottom:16px">
                <label class="label">Name</label>
                <input class="field" placeholder="Category name" @bind="formName" />
            </div>
            <div style="margin-bottom:24px">
                <label class="label">Description</label>
                <input class="field" placeholder="Short description" @bind="formDesc" />
            </div>
            <div style="display:flex;gap:8px">
                <button class="btn btn--primary btn--sm" @onclick="Save">Save</button>
                <button class="btn btn--ghost btn--sm" @onclick="CancelForm">Cancel</button>
            </div>
        </div>
    }

    @if (categories == null)
    {
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px">
            @for (int i = 0; i < 6; i++)
            {
                <div>
                    <div class="skeleton" style="height:180px;border-radius:var(--radius-lg)"></div>
                    <div class="skeleton" style="height:18px;width:60%;margin-top:14px;border-radius:4px"></div>
                </div>
            }
        </div>
    }
    else
    {
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px">
            @foreach (var cat in categories)
            {
                <div class="surface" style="padding:28px;display:flex;flex-direction:column;gap:12px">
                    <h3 style="font-size:22px">@cat.Name</h3>
                    @if (!string.IsNullOrEmpty(cat.Description))
                    {
                        <p style="font-size:14px;color:var(--muted);margin:0;line-height:1.6">@cat.Description</p>
                    }
                    <div style="margin-top:auto;display:flex;gap:8px;padding-top:16px;flex-wrap:wrap">
                        <a href="/products?categoryId=@cat.Id" class="btn btn--ghost btn--sm">Browse</a>
                        <AuthorizeView Roles="Admin">
                            <button class="btn btn--ghost btn--sm" @onclick="() => StartEdit(cat)">Edit</button>
                            <button class="btn btn--danger btn--sm" @onclick="() => Delete(cat.Id)">Delete</button>
                        </AuthorizeView>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private IList<CategoryDto>? categories;
    private bool showForm;
    private CategoryDto? editing;
    private string formName = string.Empty;
    private string formDesc = string.Empty;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => categories = await CategoryApi.GetAllAsync();

    private void ShowCreate() { editing = null; formName = ""; formDesc = ""; showForm = true; }

    private void StartEdit(CategoryDto cat)
    {
        editing = cat;
        formName = cat.Name;
        formDesc = cat.Description;
        showForm = true;
    }

    private void CancelForm() { showForm = false; editing = null; }

    private async Task Save()
    {
        if (editing == null)
            await CategoryApi.CreateAsync(new CreateCategoryRequest { Name = formName, Description = formDesc });
        else
            await CategoryApi.UpdateAsync(editing.Id, new UpdateCategoryRequest { Name = formName, Description = formDesc, IsActive = true });

        showForm = false;
        editing = null;
        await LoadAsync();
    }

    private async Task Delete(int id)
    {
        await CategoryApi.DeleteAsync(id);
        await LoadAsync();
    }
}
