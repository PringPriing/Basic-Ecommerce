@page "/"
@inject ProductApiService ProductApi

<PageTitle>Maison. — E-Shop</PageTitle>

<!-- Hero -->
<section class="container" style="padding:64px 32px 80px">
    <div style="display:grid;grid-template-columns:1.1fr 1fr;gap:56px;align-items:center">
        <div>
            <div class="eyebrow" style="margin-bottom:20px">New Collection · 2026</div>
            <h1 style="font-size:clamp(48px,6vw,80px);margin-bottom:24px">
                Objects made <em style="font-style:italic;color:var(--accent)">carefully</em>,<br />
                chosen well.
            </h1>
            <p style="font-size:17px;color:var(--ink-2);max-width:480px;margin-bottom:32px;line-height:1.6">
                A curated shop for the home — built around honest materials and pieces that earn their place over years, not seasons.
            </p>
            <div style="display:flex;gap:12px">
                <a href="/products" class="btn btn--primary btn--lg">
                    Shop the collection
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18">
                        <path d="M5 12h14m-5-6 6 6-6 6"/>
                    </svg>
                </a>
                <a href="/categories" class="btn btn--ghost btn--lg">Browse categories</a>
            </div>
            <div style="margin-top:48px;display:flex;gap:32px;padding-top:24px;border-top:1px solid var(--line)">
                <div style="display:flex;align-items:center;gap:10px;font-size:13px;color:var(--ink-2)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" width="20" height="20">
                        <path d="M3 7h11v10H3zM14 10h4l3 3v4h-7"/><circle cx="7" cy="18" r="1.7"/><circle cx="17" cy="18" r="1.7"/>
                    </svg>
                    Free shipping over $80
                </div>
                <div style="display:flex;align-items:center;gap:10px;font-size:13px;color:var(--ink-2)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" width="20" height="20">
                        <path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/>
                    </svg>
                    30-day returns
                </div>
                <div style="display:flex;align-items:center;gap:10px;font-size:13px;color:var(--ink-2)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" width="20" height="20">
                        <path d="M12 3 4 6v6c0 5 3.5 8.5 8 9 4.5-.5 8-4 8-9V6z"/><path d="m9 12 2 2 4-4"/>
                    </svg>
                    Secure checkout
                </div>
            </div>
        </div>

        <div style="position:relative;aspect-ratio:4/5;border-radius:18px;overflow:hidden;background:var(--surface-2)">
            @{
                var heroImg = featured?.Items.FirstOrDefault()?.ImageUrl;
            }
            @if (!string.IsNullOrEmpty(heroImg))
            {
                <img src="@heroImg" style="width:100%;height:100%;object-fit:cover" alt="Featured product" />
            }
            else
            {
                <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center">
                    <svg viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="1" width="64" height="64">
                        <rect x="3" y="3" width="18" height="18" rx="2"/>
                        <circle cx="8.5" cy="8.5" r="1.5"/>
                        <path d="m21 15-5-5L5 21"/>
                    </svg>
                </div>
            }
        </div>
    </div>
</section>

<!-- Featured Products -->
<section class="container" style="padding-bottom:80px">
    <header style="display:flex;justify-content:space-between;align-items:end;margin-bottom:32px">
        <div>
            <div class="eyebrow">New arrivals</div>
            <h2 style="font-size:44px;margin-top:8px">This season's additions</h2>
        </div>
        <a href="/products" class="btn btn--link">
            View all products
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18">
                <path d="M5 12h14m-5-6 6 6-6 6"/>
            </svg>
        </a>
    </header>

    @if (featured == null)
    {
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:28px">
            @for (int i = 0; i < 6; i++)
            {
                <div>
                    <div class="skeleton" style="aspect-ratio:4/5;border-radius:var(--radius)"></div>
                    <div class="skeleton" style="height:16px;margin-top:14px;border-radius:4px;width:80%"></div>
                    <div class="skeleton" style="height:12px;margin-top:8px;border-radius:4px;width:50%"></div>
                </div>
            }
        </div>
    }
    else
    {
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:28px">
            @foreach (var product in featured.Items)
            {
                <ProductCard Product="product" />
            }
        </div>
    }
</section>

@code {
    private PagedResult<ProductSummaryDto>? featured;

    protected override async Task OnInitializedAsync()
    {
        featured = await ProductApi.SearchAsync(new ProductSearchRequest { PageSize = 6 });
    }
}
