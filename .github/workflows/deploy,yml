name: Deploy to Azure

  on:
    push:
      branches:
        - master

  jobs:
    build-and-deploy:
      runs-on: ubuntu-latest

      steps:
      - uses: actions/checkout@v4

      - name: Setup .NET 8
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: '8.x'

      - name: Restore
        run: dotnet restore Server/Ecommerce.Server.csproj

      - name: Build
        run: dotnet build Server/Ecommerce.Server.csproj --configuration Release --no-restore

      - name: Publish
        run: dotnet publish Server/Ecommerce.Server.csproj --configuration Release --output ./publish

      - name: Deploy to Azure Web App
        uses: azure/webapps-deploy@v3
        with:
          app-name: 'app-ecommerce-prince'
          publish-profile: ${{ secrets.AZURE_WEBAPP_PUBLISH_PROFILE }}
          package: ./publish
